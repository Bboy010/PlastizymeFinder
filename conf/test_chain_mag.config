/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder test configuration — chained after nf-core/mag
    Run with: nextflow run main.nf -profile test_chain_mag,docker --outdir results_chain
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    --contigs_input on the MEGAHIT assemblies that nf-core/mag's own
    test_assembly_input profile takes, from nf-core/test-datasets. No bins
    column: every contig goes to stage 7 as unbinned. The branch with bins is
    exercised by running mag, then bin/mag2plastizyme.py (see the README).
*/

params {
    config_profile_name        = 'Test profile (chained after nf-core/mag)'
    config_profile_description = 'MEGAHIT assemblies from nf-core/test-datasets, as used by nf-core/mag test_assembly_input'

    contigs_input = "${projectDir}/assets/samplesheet_mag_contigs.csv"
    pet_db        = "${projectDir}/assets/testdata/pet_db_test.fasta"

    // Stage 5/6 (skip_annotation, and so drep_checkm with it) are already
    // forced off for --contigs_input by the workflow itself; only stage 8
    // needs disabling here, for a fast test.
    skip_structure = true
}

process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   1.h
    ]
}
