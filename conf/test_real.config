/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder — real-data test profile

    Runs the actual tools on a 100,000-read-pair subset of two published
    samples, one per site. Minutes rather than days; see
    assets/testdata/real/README.md for what this does and does not prove.

    Run with: nextflow run main.nf -profile test_real,docker --outdir results
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Real-data test profile'
    config_profile_description = 'Two published samples, subsampled to 100k read pairs each'

    input  = "${projectDir}/assets/testdata/real/samplesheet_real.csv"

    // The curated PET_DB published with the study, fetched by DOI.
    pet_db = 'https://zenodo.org/records/21844692/files/pet_cdhit95.faa?download=1'

    // Databases resolve through the pipeline's own download modules.
    kraken2_db    = null
    metaphlan4_db = null
    gtdbtk_db     = null
    dbcan2_db     = null
    eggnog_db     = null
    kofamscan_db  = null
    checkm_db     = null
    cdd_db        = null
    cdd_db_set    = 'Pfam'

    // The study screened with a minimum bit-score of 250 (Methods 2.4.2).
    metarenz_mode     = 'cs'
    metarenz_bitscore = 250

    min_contig_len = 1500
    min_bin_size   = 2000

    // dRep filters on CheckM completeness/contamination, as the study did.
    skip_drep_checkm  = false
    min_completeness  = 50
    max_contamination = 10
    // The subsampled reads assemble into a few kb of contigs; dRep's 50 kb
    // default would discard every bin before the step does any work.
    drep_min_length   = 2000
    // The bins are ~2.5 kb, below fastANI's 3 kb fragment length: secondary
    // clustering can only fail on them, so stop at MASH.
    drep_skip_secondary = true

    // Every stage runs: ColabFold folds whatever METARENZ hands it, and
    // TM-align compares the result with the reference PETase.
    skip_structure = false
}

process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   6.h
    ]
}
