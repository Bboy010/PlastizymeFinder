/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder — full-sample run, Bietry_1

    Runs every stage on the complete, unsubsampled Bietry_1 reads (~2 GB per
    mate) to get real time and memory figures, and to see whether the
    published BietPETase1/3/4 are recovered from raw reads. Not a CI profile:
    resource limits are set for this machine (10 cores, 33 GB free), not for
    a shared runner.

    Run with:
        nextflow run main.nf -profile full_bietry1,local_dbs,docker \
            --outdir results_full_bietry1 -w work_full_bietry1
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Full sample: Bietry_1'
    config_profile_description = 'Complete, unsubsampled reads for one sample - real timing and memory, not a smoke test'

    input = "${projectDir}/assets/testdata/real/samplesheet_full_bietry1.csv"

    pet_db = "/home/blackboy/test/metarenz_input/pet_cdhit95.faa"

    metarenz_mode     = 'cs'
    metarenz_bitscore = 250

    min_contig_len = 1500
    min_bin_size   = 2000

    skip_drep_checkm  = false
    min_completeness  = 50
    max_contamination = 10
    drep_min_length   = 2000
    drep_skip_secondary = false

    skip_structure = false
}

process {
    resourceLimits = [
        cpus:   8,
        memory: '28.GB',
        time:   48.h
    ]
}
