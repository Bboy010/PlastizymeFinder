/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder test configuration — nf-core/mag test data
    Run with: nextflow run main.nf -profile test_mag,docker --outdir results_test_mag
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    The subsampled gut metagenome (two samples, paired-end) that nf-core/mag's
    own -profile test runs on, from nf-core/test-datasets. It holds no known
    PETase: this profile checks that assembly, the three binners and DAS Tool
    chain together on real reads, not that a plastizyme is found - the
    biological check is the Bietry_1 run (conf/full_bietry1.config).
*/

params {
    config_profile_name        = 'Test profile (nf-core/mag test data)'
    config_profile_description = 'Subsampled gut metagenome from nf-core/test-datasets, as used by nf-core/mag -profile test'

    input   = "${projectDir}/assets/samplesheet_minigut.csv"
    pet_db  = "${projectDir}/assets/testdata/pet_db_test.fasta"

    // Binning as in nf-core/mag -profile test: CONCOCT is its slowest binner
    // and is skipped there too. MetaBAT2, MaxBin2 and DAS Tool run.
    skip_maxbin2        = false
    skip_concoct        = true
    refine_bins_dastool = true
    // No bin of this subsampled data reaches DAS Tool's default 0.5, which
    // would leave the refined-bin path untested. nf-core/mag's
    // test_assembly_input lowers it to 0 for the same reason.
    dastool_score_threshold = 0.0

    // Stage 4 is what this profile is for; the database-heavy stages are off.
    skip_taxonomy       = true
    skip_annotation     = true
    skip_structure      = true
    skip_drep_checkm    = true

    // MetaBAT2 hard minimum is 1500 bp; bins of a subsampled sample are small.
    min_contig_len  = 1500
    min_bin_size    = 2000
    drep_min_length = 10000
}

// Same sizing as nf-core/mag's test profiles (4 CPUs, 15 GB, 1 h). Only
// resourceLimits is set: a withName: block here would replace, not merge
// with, the one in conf/modules.config.
process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   1.h
    ]
}
