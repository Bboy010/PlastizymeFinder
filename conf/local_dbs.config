/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder — local database profile

    Points every stage at a database already present on this machine, so no
    download module ever runs. Combine it with any other profile, last:

        nextflow run main.nf -profile test_real,local_dbs,docker --outdir results

    The paths under /mnt/e need the external drive mounted in WSL:

        sudo mount -t drvfs E: /mnt/e

    Every path below was checked for the marker files its tool needs; see
    docs/local_databases.md for what was verified and how.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Local databases'
    config_profile_description = 'Uses the databases already on this machine; downloads nothing'

    // Roots, so a drive letter or a move is a one-line change.
    local_db_root = '/mnt/e/Bio-informatics/db'
    home_db_root  = '/home/blackboy'

    // --- Taxonomy (stage 2) ---------------------------------------------
    // MiniKraken2 v2 8 GB: hash.k2d, opts.k2d and taxo.k2d present.
    kraken2_db    = "${params.local_db_root}/minikraken2"
    // MetaPhlAn 4: mpa_vJan25_CHOCOPhlAnSGB_202503 with its .bt2l and .pkl.
    metaphlan4_db = "${params.local_db_root}/mpa_db"

    // --- Bin taxonomy and quality ---------------------------------------
    // GTDB-Tk R226 reference data: markers, pplacer, taxonomy, skani, msa.
    gtdbtk_db = "${params.local_db_root}/release226"
    checkm_db = "${params.local_db_root}/CheckM2_database"

    // --- Functional annotation (stage 6) --------------------------------
    // dbCAN V8, hmmpress'd, with CAZy.dmnd. Only dbCAN 3 reads this layout.
    dbcan2_db    = "${params.local_db_root}/db_can"
    // eggNOG 5: eggnog.db (41 GB) and eggnog_proteins.dmnd (9.3 GB).
    eggnog_db    = "${params.home_db_root}/eggnog_data"
    // KofamScan: ko_list and the profiles/ directory.
    kofamscan_db = "${params.home_db_root}/kofam_db"

    // --- Plastizyme screening (stage 7) ---------------------------------
    // The curated PET_DB published with the study: 158 sequences.
    pet_db = "${params.home_db_root}/test/metarenz_input/pet_cdhit95.faa"

    // --- Conserved domains (stage 8) ------------------------------------
    // CDD 3.21 Pfam subset, already formatted for RPS-BLAST.
    cdd_db     = "${projectDir}/databases/cdd/cdd_db"
    cdd_db_set = 'Pfam'
}
