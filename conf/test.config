/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder test configuration
    Run with: nextflow run main.nf -profile test,docker --outdir results_test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources for local PC (34 GB RAM, 6 CPUs)
    max_cpus   = 6
    max_memory = '30.GB'
    max_time   = '6.h'

    // Input — small synthetic metagenome shipped with the repository
    input   = "${projectDir}/assets/testdata/samplesheet_test.csv"

    // PET_DB — small test FASTA (10 sequences)
    pet_db  = "${projectDir}/assets/testdata/pet_db_test.fasta"

    // Skip heavy stages in test mode
    skip_structure      = true    // AlphaFold2 needs GPU
    skip_taxonomy       = false
    skip_plastizyme     = false   // MeTarEnz runs from the authors' Docker image (mforooz/metarenz)
    skip_drep_checkm    = true    // CheckM not installed in test env

    // Every database is resolved by the pipeline's own download modules so the
    // test profile stays portable: no machine-specific path may leak in here.
    kraken2_db    = null
    metaphlan4_db = null
    gtdbtk_db     = null
    dbcan2_db     = null
    eggnog_db     = null
    kofamscan_db  = null
    checkm_db     = null
    cdd_db        = null

    // Pfam subset (~410 MB) instead of the full CDD (~1.7 GB) for RPS-BLAST
    cdd_db_set    = 'Pfam'

    // Restrict assembly — MetaBAT2 hard minimum is 1500 bp
    min_contig_len = 1500
    min_bin_size   = 2000
}

// Resource caps for local test execution.
//
// Only `resourceLimits` is set here, deliberately. A `withName:` block in this
// file does NOT merge with the one in conf/modules.config — it replaces it, so
// re-declaring a process here silently drops its ext.args, container override
// and publishDir. `resourceLimits` caps every process without touching them.
process {
    resourceLimits = [
        cpus:   6,
        memory: 30.GB,
        time:   6.h
    ]
}
