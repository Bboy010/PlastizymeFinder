/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder test configuration
    Run with: nextflow run main.nf -profile test,docker --outdir results_test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources for local PC (34 GB RAM, 6 CPUs)
    max_cpus   = 6
    max_memory = '30.GB'
    max_time   = '6.h'

    // Input — small synthetic metagenome (to be added in assets/testdata/)
    input   = "${projectDir}/assets/testdata/samplesheet_test.csv"

    // PET_DB — small test FASTA (10 sequences)
    pet_db  = "${projectDir}/assets/testdata/pet_db_test.fasta"

    // Skip heavy stages in test mode
    skip_structure      = true    // AlphaFold2 needs GPU
    skip_taxonomy       = false
    skip_plastizyme     = true    // METATARENZ container not yet published — skip in test
    skip_drep_checkm    = true    // CheckM not installed in test env

    // Use prebuilt tiny databases for test
    kraken2_db    = null      // auto-download mini DB
    metaphlan4_db = null

    // Restrict assembly — MetaBAT2 hard minimum is 1500 bp
    min_contig_len = 1500
    min_bin_size   = 2000
}

// Hard resource caps for local test execution (34 GB RAM, 6 CPUs)
// withLabel overrides are evaluated after base.config so they take precedence
process {
    resourceLimits = [
        cpus:   6,
        memory: 30.GB,
        time:   6.h
    ]
    withLabel: 'process_single' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
    withLabel: 'process_high' {
        cpus   = 6
        memory = 28.GB
        time   = 6.h
    }
    withName: 'BOWTIE2_ALIGN_CONTIGS' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
    withName: 'MEGAHIT' {
        cpus   = 6
        memory = 28.GB
        time   = 6.h
    }
    withName: 'METABAT2' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
    withName: 'KRAKEN2' {
        cpus   = 6
        memory = 28.GB
        time   = 4.h
    }
    withName: 'GTDBTK_CLASSIFYWF' {
        cpus   = 6
        memory = 28.GB
        time   = 6.h
    }
    withName: 'EGGNOG_MAPPER' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
}
