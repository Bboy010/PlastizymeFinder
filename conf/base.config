/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder base resource configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // -----------------------------------------------------------------------
    // LABELS — referenced by modules via `label 'process_low'` etc.
    // -----------------------------------------------------------------------
    withLabel: process_single {
        cpus   = { 1 }
        memory = { 6.GB   * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withLabel: process_low {
        cpus   = { Math.min(2  * task.attempt, params.max_cpus as int) }
        memory = { 12.GB  * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { Math.min(6  * task.attempt, params.max_cpus as int) }
        memory = { 36.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withLabel: process_high {
        cpus   = { Math.min(12 * task.attempt, params.max_cpus as int) }
        memory = { 30.GB  * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withLabel: process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // -----------------------------------------------------------------------
    // TOOL-SPECIFIC RESOURCE OVERRIDES
    // -----------------------------------------------------------------------
    withName: 'MEGAHIT' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 40.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withName: 'METABAT2' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: 'GTDBTK_CLASSIFYWF' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 80.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withName: 'ALPHAFOLD2' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 60.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        // GPU recommended — set accelerator in your cluster config
        // accelerator = 1
    }
    withName: 'KRAKEN2' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 60.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: 'EGGNOG_MAPPER' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withName: 'KOFAMSCAN' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: '.*DB_DOWNLOAD.*' {
        // Database downloads can be slow — extend time, single CPU
        cpus   = { 2              }
        memory = { 4.GB           }
        time   = { 12.h           }
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}
