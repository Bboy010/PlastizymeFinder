/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder modules configuration
    Defines ext.args and publishDir for each process
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // -----------------------------------------------------------------------
    // Stage 1 — QC & Preprocessing
    // -----------------------------------------------------------------------
    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        memory     = 10.GB  // FastQC --memory max is 10000 MB; 8 GB = 8000 MB
        publishDir = [
            path: { "${params.outdir}/fastqc/raw" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }
    withName: 'FASTP' {
        ext.args   = '--qualified_quality_phred 20 --length_required 50 --detect_adapter_for_pe'
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,json,fastq.gz}'
        ]
    }
    withName: 'BOWTIE2_BUILD' {
        container  = 'docker://staphb/bowtie2:2.5.3'
    }
    withName: 'BOWTIE2_ALIGN_HOST' {
        ext.args   = '--very-sensitive --no-unal'
        // bowtie2/align needs bowtie2 + samtools — mulled image often absent from Galaxy depot
        container  = 'docker://staphb/bowtie2:2.5.3'
        publishDir = [
            path: { "${params.outdir}/host_removal" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,log}'
        ]
    }
    withName: 'FASTQC_TRIMMED' {
        ext.args   = '--quiet'
        memory     = 8.GB  // FastQC --memory max is 10000 MB; 8 GB = 8000 MB
        publishDir = [
            path: { "${params.outdir}/fastqc/trimmed" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 2 — Taxonomic Profiling
    // -----------------------------------------------------------------------
    withName: 'KRAKEN2' {
        ext.args   = '--report-zero-counts'
        // Override container: the mulled Singularity image doesn't exist at the depot
        container  = 'docker://staphb/kraken2:2.1.3'
        publishDir = [
            path: { "${params.outdir}/taxonomy/kraken2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'METAPHLAN4' {
        ext.args   = '--tax_lev a'
        publishDir = [
            path: { "${params.outdir}/taxonomy/metaphlan4" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 3 — Assembly
    // -----------------------------------------------------------------------
    withName: 'MEGAHIT' {
        ext.args   = { "--min-contig-len ${params.min_contig_len}" }
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.{fa.gz,log}'
        ]
    }
    withName: 'QUAST_ASSEMBLY' {
        ext.prefix = 'assembly'
        ext.args   = { "--min-contig ${params.min_contig_len}" }
        publishDir = [
            path: { "${params.outdir}/assembly/quast" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'PRODIGAL' {
        ext.args   = '-p meta -f gff'
        publishDir = [
            path: { "${params.outdir}/annotation/prodigal/${params.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : "${filename.tokenize('.')[0]}/${filename}" }
        ]
    }
    withName: 'BOWTIE2_ALIGN_CONTIGS' {
        cpus       = { Math.min(4, params.max_cpus as int) }
        ext.args   = '--very-sensitive'
        container  = 'docker://staphb/bowtie2:2.5.3'
        publishDir = [
            path: { "${params.outdir}/assembly/coverage" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 4 — Binning
    // -----------------------------------------------------------------------
    withName: 'METABAT2' {
        ext.args   = { "--minContig ${params.min_contig_len} --minClsSize ${params.min_bin_size}" }
        publishDir = [
            path: { "${params.outdir}/binning/metabat2" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 5 — Bin QC
    // -----------------------------------------------------------------------
    withName: 'QUAST_BINS' {
        ext.prefix = 'bins'
        publishDir = [
            path: { "${params.outdir}/bin_qc/quast" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'DREP' {
        ext.args   = { params.skip_drep_checkm ? '--ignoreGenomeQuality' : "-comp ${params.min_completeness} -con ${params.max_contamination}" }
        publishDir = [
            path: { "${params.outdir}/bin_qc/drep" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 6 — Bin Classification & Annotation
    // -----------------------------------------------------------------------
    withName: 'PROKKA' {
        ext.args   = '--metagenome --compliant'
        publishDir = [
            path: { "${params.outdir}/annotation/prokka" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CDHIT' {
        ext.args   = '-c 0.95 -n 5 -M 0 -T 0'
        publishDir = [
            path: { "${params.outdir}/annotation/cdhit" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GTDBTK_CLASSIFYWF' {
        // GTDB-Tk v2.x requires --skip_ani_screen (or --mash_db) — mandatory since v2.0
        ext.args   = '--skip_ani_screen'
        publishDir = [
            path: { "${params.outdir}/taxonomy/gtdbtk" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'EGGNOG_MAPPER' {
        ext.args   = '--itype proteins'
        publishDir = [
            path: { "${params.outdir}/annotation/eggnog" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'DBCAN2' {
        publishDir = [
            path: { "${params.outdir}/annotation/dbcan2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'KOFAMSCAN' {
        publishDir = [
            path: { "${params.outdir}/annotation/kofamscan" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 7 — Plastizyme Prediction
    // -----------------------------------------------------------------------
    withName: 'METATARENZ' {
        publishDir = [
            path: { "${params.outdir}/plastizyme_prediction/metatarenz" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 8 — 3D Structure Prediction
    // -----------------------------------------------------------------------
    withName: 'CDSEARCH' {
        publishDir = [
            path: { "${params.outdir}/structure/cdsearch" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'ALPHAFOLD2' {
        publishDir = [
            path: { "${params.outdir}/structure/alphafold2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'TMALIGN' {
        publishDir = [
            path: { "${params.outdir}/structure/tmalign" },
            mode: params.publish_dir_mode
        ]
    }
}
