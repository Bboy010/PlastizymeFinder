/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder modules configuration
    Defines ext.args and publishDir for each process
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // -----------------------------------------------------------------------
    // Stage 1 — QC & Preprocessing
    // -----------------------------------------------------------------------
    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        memory     = 10.GB  // FastQC --memory max is 10000 MB; 8 GB = 8000 MB
        publishDir = [
            path: { "${params.outdir}/fastqc/raw" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }
    withName: 'FASTP' {
        ext.args   = '--qualified_quality_phred 20 --length_required 50 --detect_adapter_for_pe'
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,json,fastq.gz}'
        ]
    }
    withName: 'BOWTIE2_BUILD' {
        // The index is an intermediate, not a result: do not publish it.
        publishDir = [ enabled: false ]
    }
    withName: 'BOWTIE2_ALIGN_HOST' {
        ext.args   = '--very-sensitive --no-unal'
        publishDir = [
            path: { "${params.outdir}/host_removal" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,log}'
        ]
    }
    withName: 'FASTQC_TRIMMED' {
        ext.args   = '--quiet'
        memory     = 8.GB  // FastQC --memory max is 10000 MB; 8 GB = 8000 MB
        publishDir = [
            path: { "${params.outdir}/fastqc/trimmed" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 2 — Taxonomic Profiling
    // -----------------------------------------------------------------------
    withName: 'KRAKEN2' {
        ext.args   = '--report-zero-counts'
        // Override container: the mulled Singularity image doesn't exist at the depot
        container  = 'staphb/kraken2:2.1.3'
        publishDir = [
            path: { "${params.outdir}/taxonomy/kraken2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'METAPHLAN4' {
        ext.args   = '--tax_lev a'
        publishDir = [
            path: { "${params.outdir}/taxonomy/metaphlan4" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 3 — Assembly
    // -----------------------------------------------------------------------
    withName: 'MEGAHIT' {
        ext.args   = { "--min-contig-len ${params.min_contig_len}" }
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.{fa.gz,log}'
        ]
    }
    withName: 'QUAST_ASSEMBLY' {
        ext.prefix = 'assembly'
        ext.args   = { "--min-contig ${params.min_contig_len}" }
        publishDir = [
            path: { "${params.outdir}/assembly/quast" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'PRODIGAL' {
        ext.args   = '-p meta -f gff'
        publishDir = [
            path: { "${params.outdir}/annotation/prodigal/${params.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : "${filename.tokenize('.')[0]}/${filename}" }
        ]
    }
    withName: 'BOWTIE2_ALIGN_CONTIGS' {
        cpus       = { Math.min(4, params.max_cpus as int) }
        ext.args   = '--very-sensitive'
        publishDir = [
            path: { "${params.outdir}/assembly/coverage" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 4 — Binning
    // -----------------------------------------------------------------------
    withName: 'METABAT2' {
        ext.args   = { "--minContig ${params.min_contig_len} --minClsSize ${params.min_bin_size}" }
        publishDir = [
            path: { "${params.outdir}/binning/metabat2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MAXBIN2' {
        ext.prefix = { "${meta.id}.maxbin2" }
        ext.args   = { "-min_contig_length ${params.min_contig_len}" }
        // MaxBin2 exits non-zero when it finds too few marker genes to seed a
        // bin - normal on a small sample. Drop MaxBin2 for it, as nf-core/mag does.
        errorStrategy = { task.exitStatus in [1, 255] ? 'ignore' : 'retry' }
        publishDir = [
            path: { "${params.outdir}/binning/maxbin2" },
            mode: params.publish_dir_mode,
            pattern: '*.{fasta.gz,summary}'
        ]
    }
    withName: 'GUNZIP_CONTIGS|GUNZIP_BINS|SAMTOOLS_INDEX|CONTIG2BIN' {
        publishDir = [ enabled: false ]
    }
    withName: 'CONCOCT_CUTUPFASTA' {
        // CONCOCT's recommended recipe: 10 kb chunks, no overlap.
        ext.prefix = { "${meta.id}.cut" }
        ext.args   = '-c 10000 -o 0 --merge_last'
        publishDir = [ enabled: false ]
    }
    withName: 'CONCOCT_CONCOCTCOVERAGETABLE|CONCOCT_CONCOCT|CONCOCT_MERGECUTUPCLUSTERING' {
        publishDir = [
            path: { "${params.outdir}/binning/concoct/stats" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CONCOCT_EXTRACTFASTABINS' {
        ext.prefix = { "${meta.id}.concoct" }
        publishDir = [
            path: { "${params.outdir}/binning/concoct" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'DASTOOL_DASTOOL' {
        ext.args   = { "--write_bins --write_bin_evals --score_threshold ${params.dastool_score_threshold}" }
        // DAS Tool exits 1 when no bin reaches the score threshold ("No bins
        // with bin-score >0.5 found") - a result, not a failure. The sample
        // then has no refined bin and EXTRACT_UNBINNED passes all its contigs
        // to stage 7. Same handling as nf-core/mag.
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : (task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish') }
        publishDir = [
            path: { "${params.outdir}/binning/dastool" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'EXTRACT_UNBINNED' {
        publishDir = [
            path: { "${params.outdir}/binning/unbinned" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 5 — Bin QC
    // -----------------------------------------------------------------------
    withName: 'QUAST_BINS' {
        ext.prefix = 'bins'
        publishDir = [
            path: { "${params.outdir}/bin_qc/quast" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'DREP' {
        ext.args   = {
            def quality = params.skip_drep_checkm
                ? '--ignoreGenomeQuality'
                : "-comp ${params.min_completeness} -con ${params.max_contamination}"
            def secondary = params.drep_skip_secondary ? ' --SkipSecondary' : ''
            "${quality} -l ${params.drep_min_length}${secondary}"
        }
        publishDir = [
            path: { "${params.outdir}/bin_qc/drep" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 6 — Bin Classification & Annotation
    // -----------------------------------------------------------------------
    withName: 'PROKKA' {
        ext.args   = '--metagenome --compliant'
        publishDir = [
            path: { "${params.outdir}/annotation/prokka" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CDHIT' {
        ext.args   = '-c 0.95 -n 5 -M 0 -T 0'
        publishDir = [
            path: { "${params.outdir}/annotation/cdhit" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GTDBTK_CLASSIFYWF' {
        // GTDB-Tk v2.x requires --skip_ani_screen (or --mash_db) — mandatory since v2.0
        ext.args   = '--skip_ani_screen'
        publishDir = [
            path: { "${params.outdir}/taxonomy/gtdbtk" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'EGGNOG_MAPPER' {
        // --itype is already passed by the module from its db_type input.
        publishDir = [
            path: { "${params.outdir}/annotation/eggnog" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'DBCAN2' {
        publishDir = [
            path: { "${params.outdir}/annotation/dbcan2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'KOFAMSCAN' {
        publishDir = [
            path: { "${params.outdir}/annotation/kofamscan" },
            mode: params.publish_dir_mode
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 7 — Plastizyme Prediction
    // -----------------------------------------------------------------------
    withName: 'METARENZ' {
        ext.args   = { "-bs ${params.metarenz_bitscore}" }
        publishDir = [
            path: { "${params.outdir}/plastizyme_prediction/metarenz" },
            mode: params.publish_dir_mode,
            pattern: '*.{csv,faa}'
        ]
    }

    // -----------------------------------------------------------------------
    // Stage 8 — 3D Structure Prediction
    // -----------------------------------------------------------------------
    withName: 'RPSBLAST' {
        // Same defaults as the NCBI Batch CD-Search web service
        ext.args   = '-evalue 0.01 -max_target_seqs 500'
        publishDir = [
            path: { "${params.outdir}/structure/cdsearch" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
    withName: 'COLABFOLD' {
        // Defaults follow the study: AlphaFold2 pTM models, MSA from the server.
        ext.args   = '--num-models 5 --num-recycle 3 --msa-mode mmseqs2_uniref_env'
        publishDir = [
            path: { "${params.outdir}/structure/colabfold" },
            mode: params.publish_dir_mode,
            pattern: '*.{pdb,tsv}'
        ]
    }
    withName: 'TMALIGN' {
        publishDir = [
            path: { "${params.outdir}/structure/tmalign" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
    // -----------------------------------------------------------------------
    // Reference databases - cached by storeDir, never copied into results/
    // (they weigh several GB and are not a pipeline output)
    // -----------------------------------------------------------------------
    withName: 'PLOT_REPORT' {
        publishDir = [
            path: { "${params.outdir}/figures" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn.replaceFirst('^figures/', '') }
        ]
    }

    withName: '.*_DB_DOWNLOAD' {
        publishDir = [ enabled: false ]
    }
}
