.nextflow.pid
.nextflow.history

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Python/Conda environments
.conda/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs
*.log

# System files
.DS_Store
Thumbs.db

# Singularity/Docker caches
singularity/
