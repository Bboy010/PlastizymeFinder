/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration applied to every nf-test run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// resourceLimits has to be set here rather than through params.max_*: the
// top-level process block computes it from params while nextflow.config is
// being parsed, so a params override coming from this file arrives too late.
// Without this, METARENZ asks for its production 24 GB and nf-test fails on any
// machine smaller than that - which is every CI runner.
process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   1.h
    ]
}

params {
    max_cpus   = 4
    max_memory = '15.GB'
    max_time   = '1.h'
}

