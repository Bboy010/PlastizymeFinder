/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PlastizymeFinder Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


params {

    // -----------------------------------------------------------------------
    // INPUT / OUTPUT
    // -----------------------------------------------------------------------
    input           = null          // Path to input samplesheet (CSV)
    outdir          = 'results'     // Output directory
    tracedir        = "${params.outdir}/pipeline_info"

    // -----------------------------------------------------------------------
    // REFERENCE
    // -----------------------------------------------------------------------
    host_genome     = null          // Path to host genome (FASTA) for decontamination

    // PETase reference structure for TM-Align (Stage 8)
    // Default: 6EQE (IsPETase, Ideonella sakaiensis) — auto-downloaded from RCSB if null
    // Provide your own with: --petase_ref /path/to/custom.pdb
    petase_ref      = null

    // -----------------------------------------------------------------------
    // DATABASES
    // -----------------------------------------------------------------------
    // Provide your own paths, or leave null to auto-download at runtime

    kraken2_db      = "/mnt/e/Bio-informatics/db/minikraken2"          // Path to Kraken2 database directory
    metaphlan4_db   = "/home/blackboy/metaphlan/mpc/lib/python3.13/site-packages/metaphlan/metaphlan_databases"          // Path to MetaPhlAn4 database directory
    dbcan2_db       = "/home/blackboy/databases/db_can"          // Path to dbCAN2 database directory
    eggnog_db       = "/home/blackboy/eggnog_data"          // Path to eggNOG database directory
    kofamscan_db    = "/home/blackboy/kofam_db"          // Path to KofamScan profiles directory
    gtdbtk_db       = "/mnt/e/Bio-informatics/db/release226"          // Path to GTDB-tk reference data directory
    checkm_db       = null          // Path to CheckM database (set with: checkm data setRoot /path)

    // PET_DB : required — no auto-download (manual curation required)
    // Download: https://github.com/Bboy010/PlastizymeFinder/releases
    // Guide:    docs/pet_db_guide.md
    pet_db          = "/home/blackboy/PlastizymeFinder/assets/testdata/pet_db_test.fasta"

    // Directory where databases will be downloaded if not provided
    db_cache_dir    = "${projectDir}/databases"

    // -----------------------------------------------------------------------
    // PIPELINE OPTIONS
    // -----------------------------------------------------------------------
    skip_taxonomy       = false     // Skip taxonomic profiling (Stage 2)
    skip_annotation     = false     // Skip gene annotation (Stage 6)
    skip_structure      = false     // Skip 3D structure prediction (Stage 8)
    skip_plastizyme     = false     // Skip METATARENZ plastizyme prediction (Stage 7)
    skip_drep_checkm    = false     // Skip CheckM quality check in dRep (requires CheckM installed)

    // Assembly
    assembler       = 'megahit'     // De novo assembler (megahit only for now)
    min_contig_len  = 1500          // Minimum contig length — MetaBAT2 hard minimum is 1500 bp

    // Binning
    min_bin_size    = 200000        // Minimum bin size (bp) for MetaBAT2

    // Bin QC thresholds (dRep)
    min_completeness    = 50        // Minimum bin completeness (%)
    max_contamination   = 10        // Maximum bin contamination (%)

    // -----------------------------------------------------------------------
    // BOILERPLATE OPTIONS
    // -----------------------------------------------------------------------
    help            = false
    version         = false
    publish_dir_mode = 'copy'
    email           = null
    email_on_fail   = null
    multiqc_config  = null
    multiqc_title   = null
    max_multiqc_email_size = '25.MB'
    monochrome_logs = false

    // -----------------------------------------------------------------------
    // MAX RESOURCE LIMITS (overridden by profiles)
    // -----------------------------------------------------------------------
    max_cpus        = 16
    max_memory      = '128.GB'
    max_time        = '240.h'
}

// -----------------------------------------------------------------------
// PROCESS DEFAULTS
// -----------------------------------------------------------------------
process {
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory,
        time:   params.max_time
    ]
    cpus   = { 2    * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'
}

// -----------------------------------------------------------------------
// INCLUDE CONFIGS  (loaded before profiles so profiles can override them)
// -----------------------------------------------------------------------
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// -----------------------------------------------------------------------
// PROFILES
// -----------------------------------------------------------------------
profiles {

    debug {
        process.beforeScript = 'echo $HOSTNAME'
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '60 min'
        docker.enabled          = false
        conda.enabled           = false
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    test {
        includeConfig 'conf/test.config'
    }

}

// -----------------------------------------------------------------------
// EXECUTION REPORTS
// -----------------------------------------------------------------------
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/pipeline_dag.html"
}

// -----------------------------------------------------------------------
// MANIFEST
// -----------------------------------------------------------------------
manifest {
    name            = 'PlastizymeFinder'
    author          = 'Hongo'
    homePage        = 'https://github.com/Bboy010/PlastizymeFinder'
    description     = 'Metagenomic pipeline to identify and characterize plastic-degrading enzymes'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

