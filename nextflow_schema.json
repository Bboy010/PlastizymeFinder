{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/Bboy010/PlastizymeFinder/master/nextflow_schema.json",
    "title": "PlastizymeFinder pipeline parameters",
    "description": "Metagenomic pipeline to identify and characterize plastic-degrading enzymes",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": [
                "input",
                "outdir",
                "pet_db"
            ],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to comma-separated samplesheet file containing information about samples.",
                    "help_text": "You will need to create a samplesheet with information about the samples you want to analyse before running the pipeline. Use this parameter to specify its location.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where results will be saved.",
                    "default": "results",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "databases": {
            "title": "Databases",
            "type": "object",
            "fa_icon": "fas fa-database",
            "description": "Paths to reference databases. Leave null to auto-download at runtime (except pet_db which is required).",
            "required": [
                "pet_db"
            ],
            "properties": {
                "pet_db": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to PET_DB FASTA file (plastic-degrading enzyme sequences, manually curated).",
                    "help_text": "Required. Download the default PET_DB from https://github.com/Bboy010/PlastizymeFinder/releases or build your own following docs/pet_db_guide.md",
                    "fa_icon": "fas fa-dna"
                },
                "kraken2_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to Kraken2 database directory. Auto-downloaded if not provided.",
                    "fa_icon": "fas fa-database"
                },
                "metaphlan4_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to MetaPhlAn4 database directory. Auto-downloaded if not provided.",
                    "fa_icon": "fas fa-database"
                },
                "dbcan2_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to dbCAN2 database directory. Auto-downloaded if not provided.",
                    "fa_icon": "fas fa-database"
                },
                "eggnog_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to eggNOG database directory. Auto-downloaded if not provided.",
                    "fa_icon": "fas fa-database"
                },
                "kofamscan_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to KofamScan profiles directory (ko_list + profiles/). Auto-downloaded if not provided.",
                    "fa_icon": "fas fa-database"
                },
                "gtdbtk_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to GTDB-tk reference data directory. Auto-downloaded if not provided.",
                    "fa_icon": "fas fa-database"
                },
                "db_cache_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory where databases will be downloaded if not provided.",
                    "default": "${projectDir}/databases",
                    "fa_icon": "fas fa-folder"
                }
            }
        },
        "pipeline_options": {
            "title": "Pipeline options",
            "type": "object",
            "fa_icon": "fas fa-cogs",
            "description": "Options to control pipeline behaviour.",
            "properties": {
                "skip_taxonomy": {
                    "type": "boolean",
                    "description": "Skip taxonomic profiling (Stage 2: Kraken2 + MetaPhlAn4).",
                    "default": false,
                    "fa_icon": "fas fa-forward"
                },
                "skip_annotation": {
                    "type": "boolean",
                    "description": "Skip gene annotation (Stage 6: eggNOG, dbCAN2, kofamscan).",
                    "default": false,
                    "fa_icon": "fas fa-forward"
                },
                "skip_structure": {
                    "type": "boolean",
                    "description": "Skip 3D structure prediction (Stage 8: AlphaFold2 + TM-Align).",
                    "default": false,
                    "fa_icon": "fas fa-forward"
                },
                "host_genome": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to host genome FASTA for decontamination (Bowtie2 in Stage 1).",
                    "fa_icon": "fas fa-dna"
                },
                "min_contig_len": {
                    "type": "integer",
                    "description": "Minimum contig length (bp) to keep after assembly. MetaBAT2 refuses anything below 1500.",
                    "default": 1500,
                    "fa_icon": "fas fa-ruler"
                },
                "min_bin_size": {
                    "type": "integer",
                    "description": "Minimum bin size (bp) for MetaBAT2.",
                    "default": 200000,
                    "fa_icon": "fas fa-ruler"
                },
                "min_completeness": {
                    "type": "number",
                    "description": "Minimum bin completeness (%) for dRep filtering.",
                    "default": 50,
                    "fa_icon": "fas fa-percentage"
                },
                "max_contamination": {
                    "type": "number",
                    "description": "Maximum bin contamination (%) for dRep filtering.",
                    "default": 10,
                    "fa_icon": "fas fa-percentage"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline.",
            "properties": {
                "help": {
                    "type": "boolean",
                    "description": "Display help text.",
                    "fa_icon": "fas fa-question-circle"
                },
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle"
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method used to save pipeline results to output directory.",
                    "enum": [
                        "symlink",
                        "rellink",
                        "link",
                        "copy",
                        "copyNoFollow",
                        "move"
                    ],
                    "fa_icon": "fas fa-copy"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for completion summary.",
                    "fa_icon": "fas fa-envelope"
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "fa_icon": "fas fa-palette"
                },
                "multiqc_config": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Custom config file to supply to MultiQC.",
                    "fa_icon": "fas fa-cog"
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for completion summary, only on pipeline failure."
                },
                "multiqc_title": {
                    "type": "string",
                    "description": "Custom title printed in the MultiQC report."
                },
                "max_multiqc_email_size": {
                    "type": "string",
                    "default": "25.MB",
                    "description": "Maximum size of the MultiQC report to email."
                },
                "tracedir": {
                    "type": "string",
                    "description": "Directory for pipeline execution reports.",
                    "hidden": true
                },
                "assembler": {
                    "type": "string",
                    "default": "megahit",
                    "enum": [
                        "megahit"
                    ],
                    "description": "De novo assembler."
                },
                "checkm_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "CheckM database directory."
                },
                "skip_drep_checkm": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run dRep without CheckM quality filtering."
                }
            }
        },
        "plastizyme_prediction": {
            "title": "Plastizyme prediction",
            "description": "Options for the MeTarEnz screening step (Stage 7).",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "properties": {
                "metarenz_mode": {
                    "type": "string",
                    "default": "cs",
                    "enum": [
                        "cs",
                        "ps"
                    ],
                    "description": "MeTarEnz screening mode: 'cs' screens nucleotide contigs with BLASTX, 'ps' screens proteins with BLASTP."
                },
                "metarenz_bitscore": {
                    "type": "integer",
                    "default": 50,
                    "minimum": 0,
                    "description": "Minimum bit-score for a candidate to be reported."
                },
                "skip_plastizyme": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip Stage 7 (plastizyme prediction)."
                }
            }
        },
        "structure_validation": {
            "title": "Structure validation",
            "description": "Options for conserved-domain search and 3D structure prediction (Stage 8).",
            "type": "object",
            "fa_icon": "fas fa-cube",
            "properties": {
                "petase_ref": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Reference PETase PDB for TM-Align. Downloads 6EQE when unset."
                },
                "cdd_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Pre-formatted NCBI CDD RPS-BLAST database. Downloaded when unset."
                },
                "cdd_db_set": {
                    "type": "string",
                    "default": "Cdd",
                    "enum": [
                        "Cdd",
                        "Pfam"
                    ],
                    "description": "CDD subset to download: 'Cdd' (full, ~1.7 GB) or 'Pfam' (~410 MB)."
                }
            }
        },
        "max_job_request_options": {
            "title": "Max Job Request Options",
            "type": "object",
            "properties": {
                "max_cpus": {
                    "type": "integer",
                    "default": 16,
                    "description": "Maximum CPUs for any single job."
                },
                "max_memory": {
                    "type": "string",
                    "default": "128.GB",
                    "description": "Maximum memory for any single job."
                },
                "max_time": {
                    "type": "string",
                    "default": "240.h",
                    "description": "Maximum time for any single job."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/databases"
        },
        {
            "$ref": "#/definitions/pipeline_options"
        },
        {
            "$ref": "#/definitions/generic_options"
        }
    ]
}
